// Run "npm run seed" first to create the admin account (see .env)

###
//login as admin
POST http://localhost:5000/login
Content-Type: application/json

{
    "email":"admin@groupsave.test",
    "password":"<ADMIN_PASSWORD from .env>"
}

###
//who is logged in
GET http://localhost:5000/me

###
//create a member (admin only)
POST http://localhost:5000/users
Content-Type: application/json

{
    "name": "Jane Member",
    "email":"jane@groupsave.test",
    "password":"member123",
    "confPassword":"member123",
    "idNumber": "12345678",
    "phoneNumber":"0712345678",
    "role":"user"
}

###
//get all users (admin only)
GET http://localhost:5000/users

###
//get all savings (admin sees everyone, member sees their own)
GET http://localhost:5000/savings

###
//add a saving
POST http://localhost:5000/savings
Content-Type: application/json

{
    "name": "October contribution",
    "amount": 500,
    "paymentDate": "2026-10-15"
}

###
//pay via M-Pesa (sandbox)
POST http://localhost:5000/mpesa/stkpush
Content-Type: application/json

{
    "phone": "0712345678",
    "amount": 1
}

###
//logout
DELETE http://localhost:5000/logout
