{
  "info": {
    "name": "Group Save API",
    "description": "REST API for the Group Savings app (Node.js, Express, Sequelize, PostgreSQL).\n\nLogin uses a session cookie, so run **Auth > Login as admin** first. Postman keeps the cookie for the next requests.\n\nSet `adminPassword` in the collection variables before running (it is in Backend/.env).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "adminEmail",
      "value": "admin@groupsave.test"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "memberEmail",
      "value": "jane@groupsave.test"
    },
    {
      "key": "memberPassword",
      "value": "member123"
    },
    {
      "key": "savingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth (admin)",
      "item": [
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{adminEmail}}\",\n    \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Logged in as admin\", function () {",
                  "    pm.expect(pm.response.json().role).to.eql(\"admin\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with wrong password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Should fail with 400. The admin session from the previous login is kept.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{adminEmail}}\",\n    \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Shows error message\", function () {",
                  "    pm.expect(pm.response.json().msg).to.eql(\"Wrong Password\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Users (admin only)",
      "item": [
        {
          "name": "Get all users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns users\", function () {",
                  "    pm.expect(pm.response.json().length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Savings (admin)",
      "item": [
        {
          "name": "Add a saving",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/savings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "savings"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Postman test saving\",\n    \"amount\": 1000,\n    \"paymentDate\": \"2026-10-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get all savings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/savings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "savings"
              ]
            },
            "description": "Admin sees every member's savings. Saves the test saving's id into {{savingId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const savings = pm.response.json();",
                  "pm.test(\"Returns a list of savings\", function () {",
                  "    pm.expect(savings).to.be.an(\"array\");",
                  "});",
                  "// remember the newest saving so the next requests can edit and delete it",
                  "const mine = savings.find(s => s.name === \"Postman test saving\");",
                  "if (mine) { pm.collectionVariables.set(\"savingId\", mine.uuid); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get one saving",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/savings/{{savingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "savings",
                "{{savingId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Correct saving returned\", function () {",
                  "    pm.expect(pm.response.json().uuid).to.eql(pm.collectionVariables.get(\"savingId\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update a saving",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/savings/{{savingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "savings",
                "{{savingId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Postman test saving\",\n    \"amount\": 1500,\n    \"paymentDate\": \"2026-10-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete a saving",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/savings/{{savingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "savings",
                "{{savingId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get deleted saving",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/savings/{{savingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "savings",
                "{{savingId}}"
              ]
            },
            "description": "Should be 404 after the delete."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logout"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Member access rules",
      "item": [
        {
          "name": "Not logged in cannot see savings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/savings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "savings"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{memberEmail}}\",\n    \"password\": \"{{memberPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Logged in as member\", function () {",
                  "    pm.expect(pm.response.json().role).to.eql(\"user\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Member sees only own savings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/savings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "savings"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Member only sees their own savings\", function () {",
                  "    const email = pm.collectionVariables.get(\"memberEmail\");",
                  "    pm.response.json().forEach(s => pm.expect(s.user.email).to.eql(email));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Member cannot list users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 403\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test(\"Access is denied\", function () {",
                  "    pm.expect(pm.response.json().msg).to.eql(\"Access Denied\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout member",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logout"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. M-Pesa (sandbox)",
      "item": [
        {
          "name": "STK push",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mpesa/stkpush",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mpesa",
                "stkpush"
              ]
            },
            "description": "Sends an M-Pesa payment prompt. Needs MPESA_CONSUMER_KEY and MPESA_CONSUMER_SECRET in Backend/.env and a logged-in user.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"phone\": \"0712345678\",\n    \"amount\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}